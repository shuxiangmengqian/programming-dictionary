.poster-canvas {
  width: 100%;
  height: 1120rpx;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 60rpx rgba(124, 92, 255, 0.35);
}

.actions {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin-bottom: 24rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #c4b5fd;
  border: 1rpx solid rgba(167, 139, 250, 0.4);
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(124, 92, 255, 0.18);
}

.share-btn:active {
  transform: scale(0.97);
  background: rgba(167, 139, 250, 0.15);
}

.share-btn::after {
  border: none;
}

.light .share-btn {
  background: rgba(124, 92, 255, 0.08);
  color: #6d4fe6;
  border: 1rpx solid rgba(124, 92, 255, 0.35);
}
