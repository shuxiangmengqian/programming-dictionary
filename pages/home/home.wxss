.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 44rpx;
}

.greeting-wrap {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 46rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #9aa0c4;
}

.theme-toggle {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s;
}

.theme-toggle:active {
  transform: scale(0.9);
}

.daily-card {
  padding: 34rpx 32rpx;
  margin-bottom: 34rpx;
}

.daily-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.daily-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #c4b5fd;
}

.daily-content {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.daily-word {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-right: 20rpx;
  letter-spacing: 1rpx;
}

.daily-meaning {
  font-size: 28rpx;
  color: #a78bfa;
  font-weight: 600;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cat-card {
  position: relative;
  width: 48%;
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: all 0.2s;
  overflow: hidden;
}

.cat-emoji {
  font-size: 46rpx;
  margin-bottom: 14rpx;
}

.cat-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: inherit;
  filter: blur(2rpx);
}

.html-card { box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.28), inset 6rpx 0 0 rgba(255, 107, 74, 0.85); }
.css-card { box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.28), inset 6rpx 0 0 rgba(79, 140, 255, 0.85); }
.js-card { box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.28), inset 6rpx 0 0 rgba(255, 217, 74, 0.85); }
.py-card { box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.28), inset 6rpx 0 0 rgba(66, 184, 131, 0.85); }

.card-hover {
  transform: scale(0.95);
  opacity: 0.85;
}

.html-card:hover { box-shadow: 0 0 40rpx rgba(255, 107, 74, 0.4), inset 6rpx 0 0 rgba(255, 107, 74, 0.85); }
.css-card:hover { box-shadow: 0 0 40rpx rgba(79, 140, 255, 0.4), inset 6rpx 0 0 rgba(79, 140, 255, 0.85); }
.js-card:hover { box-shadow: 0 0 40rpx rgba(255, 217, 74, 0.35), inset 6rpx 0 0 rgba(255, 217, 74, 0.85); }
.py-card:hover { box-shadow: 0 0 40rpx rgba(66, 184, 131, 0.4), inset 6rpx 0 0 rgba(66, 184, 131, 0.85); }

.cat-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.cat-desc {
  font-size: 23rpx;
  color: #9aa0c4;
}

.cat-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.3);
}

.action-area {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-area button {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.start-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.share-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  color: #c4b5fd;
  border: 1rpx solid rgba(167, 139, 250, 0.4);
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(124, 92, 255, 0.18);
}

.share-btn:active {
  transform: scale(0.97);
  background: rgba(167, 139, 250, 0.15);
}

.share-btn::after {
  border: none;
}

.tips {
  font-size: 23rpx;
  color: #8a8fb0;
  margin-top: 6rpx;
}

.light .greeting {
  color: #5b4bd8;
  text-shadow: 0 0 14rpx rgba(124, 92, 255, 0.35);
}

.light .subtitle {
  color: #7c82a8;
}

.light .theme-toggle {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(124, 92, 255, 0.2);
  box-shadow: 0 6rpx 18rpx rgba(96, 84, 170, 0.15);
}

.light .daily-title {
  color: #6d4fe6;
}

.light .daily-word {
  color: #2b2f4a;
}

.light .daily-meaning {
  color: #7c5cff;
}

.light .cat-title {
  color: #2b2f4a;
}

.light .cat-desc {
  color: #7c82a8;
}

.light .cat-arrow {
  color: rgba(90, 80, 160, 0.35);
}

.light .html-card { box-shadow: 0 10rpx 28rpx rgba(96, 84, 170, 0.12), inset 6rpx 0 0 rgba(255, 107, 74, 0.85); }
.light .css-card { box-shadow: 0 10rpx 28rpx rgba(96, 84, 170, 0.12), inset 6rpx 0 0 rgba(79, 140, 255, 0.85); }
.light .js-card { box-shadow: 0 10rpx 28rpx rgba(96, 84, 170, 0.12), inset 6rpx 0 0 rgba(233, 176, 8, 0.85); }
.light .py-card { box-shadow: 0 10rpx 28rpx rgba(96, 84, 170, 0.12), inset 6rpx 0 0 rgba(66, 184, 131, 0.85); }

.light .share-btn {
  background: rgba(124, 92, 255, 0.08);
  color: #6d4fe6;
  border: 1rpx solid rgba(124, 92, 255, 0.35);
  box-shadow: 0 6rpx 18rpx rgba(124, 92, 255, 0.15);
}

.light .tips {
  color: #9a9ec0;
}
