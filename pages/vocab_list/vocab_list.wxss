.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #9aa0c4;
  margin-bottom: 30rpx;
}

.vocab-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.vocab-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.word-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.word {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.meaning {
  font-size: 26rpx;
  color: #a78bfa;
  flex: 1;
  margin-left: 16rpx;
  font-weight: 600;
}

.code-snippet {
  font-size: 22rpx;
  background: rgba(10, 14, 39, 0.9);
  color: #c7cbe8;
  padding: 16rpx;
  border-radius: 14rpx;
  font-family: Consolas, Monaco, monospace;
  word-break: break-all;
  line-height: 1.6;
}

.load-tip {
  text-align: center;
  color: #8a8fb0;
  font-size: 24rpx;
  padding: 30rpx 0;
}

.light .title {
  color: #2b2f4a;
}

.light .subtitle {
  color: #7c82a8;
}

.light .word {
  color: #2b2f4a;
}

.light .meaning {
  color: #7c5cff;
}

.light .code-snippet {
  background: #1e2238;
  color: #c7cbe8;
}

.light .load-tip {
  color: #9a9ec0;
}
