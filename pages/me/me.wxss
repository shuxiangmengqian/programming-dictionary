.me-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.me-page .menu-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  margin-bottom: 20rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  margin-bottom: 28rpx;
}

.login-card:active {
  transform: scale(0.98);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 4rpx solid rgba(167, 139, 250, 0.7);
  box-shadow: 0 0 30rpx rgba(124, 92, 255, 0.45);
}

.placeholder-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(167, 139, 250, 0.18);
}

.avatar-emoji {
  font-size: 64rpx;
}

.info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 24rpx;
  color: #c4b5fd;
  background: rgba(167, 139, 250, 0.14);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  align-self: flex-start;
}

.logout-btn {
  font-size: 24rpx;
  color: #8a8fb0;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
}

.logout-btn:active {
  opacity: 0.6;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  padding: 36rpx 14rpx;
  margin-bottom: 28rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 16rpx 0;
  transition: all 0.15s;
}

.stat-hover {
  background: rgba(167, 139, 250, 0.12);
  border-radius: 20rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 23rpx;
  color: #9aa0c4;
}

.progress-section {
  padding: 30rpx;
  margin-bottom: 28rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7c5cff 0%, #4f8cff 60%, #42d4a0 100%);
  border-radius: 20rpx;
  transition: width 1s ease-in-out;
  box-shadow: 0 0 20rpx rgba(124, 92, 255, 0.6);
}

.progress-text {
  font-size: 24rpx;
  color: #9aa0c4;
  text-align: right;
}

.menu-list {
  padding: 6rpx 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  color: #e8eaf6;
}

.menu-item:last-child {
  border-bottom: none;
}

.item-hover {
  opacity: 0.55;
}

.menu-text {
  font-size: 28rpx;
}

.arrow {
  color: #8a8fb0;
  font-size: 30rpx;
}

.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(6, 8, 24, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.login-panel {
  width: 82%;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 40rpx;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(167, 139, 250, 0.15);
  border: 4rpx dashed rgba(167, 139, 250, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-bottom: 36rpx;
  overflow: hidden;
}

.avatar-picker::after {
  border: none;
}

.picker-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.picker-text {
  font-size: 26rpx;
  color: #c4b5fd;
}

.nickname-input {
  width: 100%;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(167, 139, 250, 0.35);
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #e8eaf6;
  box-sizing: border-box;
  margin-bottom: 36rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 24rpx;
}

.cancel-btn {
  font-size: 26rpx;
  color: #9aa0c4;
  padding: 16rpx;
}

.cancel-btn:active {
  opacity: 0.6;
}

.light .nickname {
  color: #2b2f4a;
}

.light .tag {
  color: #6d4fe6;
  background: rgba(124, 92, 255, 0.1);
}

.light .logout-btn {
  color: #7c82a8;
  border: 1rpx solid rgba(90, 80, 160, 0.25);
}

.light .stat-num {
  color: #6d4fe6;
  text-shadow: 0 0 10rpx rgba(124, 92, 255, 0.3);
}

.light .stat-label {
  color: #7c82a8;
}

.light .progress-title {
  color: #2b2f4a;
}

.light .progress-bar-bg {
  background: rgba(90, 80, 160, 0.12);
}

.light .progress-text {
  color: #9a9ec0;
}

.light .menu-item {
  color: #2b2f4a;
  border-bottom: 1rpx solid rgba(90, 80, 160, 0.1);
}

.light .arrow {
  color: #b0b3d0;
}

.light .login-mask {
  background: rgba(90, 80, 160, 0.35);
}

.light .nickname-input {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(124, 92, 255, 0.3);
  color: #2b2f4a;
}
